# HyzerLab's settings (copy to .env; never commit .env)

# The database's password: anything long and random
#   openssl rand -base64 24
DB_PASSWORD=

# The key for secrets kept in the database (2FA): 32 random bytes, base64
#   openssl rand -base64 32
APP_SECRET=

# Where people open the app (comma-separated, exactly as in the browser's address bar)
APP_ORIGINS=https://hyzerlab.example.com

# The proxy or tunnel in front of the app, whose forwarded-for addresses are trusted
# (Docker's network, when the tunnel runs on the same machine)
TRUST_PROXY=172.16.0.0/12

# Sign-in cookies only over https (keep true unless you try it out on plain http)
COOKIE_SECURE=true

# The port on this machine (127.0.0.1 only)
PORT=8080

# A version to run (latest, or one like 2026.10.21)
HYZERLAB_VERSION=latest
